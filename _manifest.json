{
  "manifest_version": 2,
  "version": "1.0.0",
  "name": "MaiBot-Amaidesu-Adapter",
  "description": "让 Amaidesu 直播主播经 MCP 读写 QQ 群、请 QQ 麦麦说话；把直播近况、各场回顾与两边共用的长期笔记同步给 QQ 麦麦",
  "author": {
    "name": "Amaidesu 开发者",
    "url": "https://github.com/Mai-with-u"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot"
  },
  "plugin_type": "adapter",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_stream_by_group_id",
    "message.get_by_time_in_chat",
    "message.build_readable",
    "send.text",
    "frequency.get_adjust",
    "frequency.set_adjust",
    "maisaka.proactive.trigger",
    "config.get",
    "knowledge.search",
    "person.get_id",
    "person.get_id_by_name",
    "person.get_value"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "amaidesu.amaidesu-adapter"
}
